# Домен и публичный адрес сайта
DOMAIN=example.ru
SITE_URL=https://example.ru

# Какой конфиг nginx подключать: http.conf до получения сертификата, https.conf после
NGINX_CONF=http.conf

# База
POSTGRES_DB=countur
POSTGRES_USER=countur
POSTGRES_PASSWORD=change-me

# Бэкенд
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-min-8-chars
WEB_WORKERS=3
COOKIE_SECURE=false
