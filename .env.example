# Домен и публичный адрес сайта
DOMAIN=example.ru
SITE_URL=https://example.ru

# Какой конфиг nginx подключать: http.conf до получения сертификата, https.conf после
NGINX_CONF=http.conf

# База
POSTGRES_DB=countur
POSTGRES_USER=countur
POSTGRES_PASSWORD=change-me

# Подключение при запуске Python вне Docker. В Compose сервисы используют хост postgres.
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Бэкенд
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-min-8-chars
WEB_WORKERS=3
COOKIE_SECURE=false
JWT_EXPIRES_DAYS=7
SHOP_TIMEZONE=Europe/Moscow

# Адреса для локальной разработки без Docker
API_INTERNAL_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_API_URL=/api
CORS_ORIGINS=["http://localhost:3000"]
MEDIA_DIR=media
DEBUG=false

# Бот поддержки
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=

# Почта для ответов на обращения из админки. Пусто — ответы не отправляются
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# СДЭК. Код города отправки указан в справочнике СДЭК.
CDEK_ACCOUNT=
CDEK_PASSWORD=
CDEK_ORIGIN_CITY_CODE=0
